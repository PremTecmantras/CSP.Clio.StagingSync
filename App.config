<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="CSP.Clio.Sync.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <appSettings>
    <add key="StagingDatabaseName" value="Clio_Staging" />
    <add key="ComparisonDatabaseName" value="EKPBI_New_Dev" />
    <add key="DocumentsRootPath" value="Documents" />
    <add key="ClioApiBaseUrl" value="https://eu.app.clio.com/api/v4/" />
    <add key="BulkBatchSize.Activities" value="1000" />
    <add key="BulkBatchSize.Allocations" value="1000" />
    <add key="BulkBatchSize.BankTransactions" value="1000" />
    <add key="BulkBatchSize.Bills" value="1000" />
    <add key="BulkBatchSize.CalendarEntries" value="1000" />
    <add key="BulkBatchSize.LineItems" value="1000" />
    <add key="BulkBatchSize.Contacts" value="1000" />
    <add key="BulkBatchSize.Matters" value="1000" />
    <add key="BulkBatchSize.MatterNotes" value="1000" />
    <add key="BulkBatchSize.Tasks" value="1000" />
    <!-- How many companies are extracted at the same time (each uses its own token / rate limit). 1 = one at a time. -->
    <add key="MaxParallelCompanies" value="4" />
    <!-- Normal Visual Studio / Task Scheduler launch has no arguments. -->
    <add key="AbandonPreviousRunningRun" value="true" />
    <add key="PublishAfterValidation" value="true" />
    <!-- Incremental polling is deliberately opt-in. Run the incremental control script and test the incremental command before setting this to true. -->
    <add key="EnableIncrementalSync" value="true" />
    <!-- Poll these Clio endpoints with updated_since. The mode only updates Clio_Staging; it never publishes partial data. -->
    <add key="IncrementalEndpoints" value="Activities,CalendarEntries,Tasks,Matters,Bills,Folders,Contacts" />
    <!-- Re-read a small overlap window so records changed during a prior poll are safely reprocessed. -->
    <add key="IncrementalOverlapMinutes" value="10" />
    <!-- First incremental poll for an endpoint starts this many hours before the first successful watermark. -->
    <add key="IncrementalInitialLookbackHours" value="24" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
