  </runtime>
  <connectionStrings>
	  <add name="EKPBIEntities" connectionString="metadata=res://*/Data.ENModel.csdl|res://*/Data.ENModel.ssdl|res://*/Data.ENModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=(localdb)\MSSQLLocalDB;initial catalog=Clio_Staging;integrated security=True;multipleactiveresultsets=True;encrypt=False;trustservercertificate=True;application name=EntityFramework&quot;" providerName="System.Data.EntityClient" />
	  <!-- Production target for validation and publication. Change Initial Catalog here when moving between production and development. -->
	  <add name="ProductionSql" connectionString="data source=(localdb)\MSSQLLocalDB;initial catalog=EKPBI_New_Dev;integrated security=True;multipleactiveresultsets=True;encrypt=False;trustservercertificate=True;application name=CSP.Clio.StagingSync" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.SqlConnectionFactory, EntityFramework" />
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
  <applicationSettings>
    <CSP.Clio.Sync.Properties.Settings>
      <setting name="DataSavePartitionSize" serializeAs="String">
        <value>50</value>
      </setting>
    </CSP.Clio.Sync.Properties.Settings>
  </applicationSettings>
</configuration>
