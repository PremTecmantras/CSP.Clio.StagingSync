<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="CSP.Clio.Sync.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <appSettings>
    <add key="StagingDatabaseName" value="Clio_Staging" />
    <add key="ComparisonDatabaseName" value="EKPBI_New_Dev" />
    <add key="DocumentsRootPath" value="Documents" />
    <add key="ClioApiBaseUrl" value="https://eu.app.clio.com/api/v4/" />
    <add key="BulkBatchSize.Activities" value="1000" />
    <add key="BulkBatchSize.Allocations" value="1000" />
    <add key="BulkBatchSize.BankTransactions" value="1000" />
    <add key="BulkBatchSize.Bills" value="1000" />
    <add key="BulkBatchSize.CalendarEntries" value="1000" />
    <add key="BulkBatchSize.LineItems" value="1000" />
    <add key="BulkBatchSize.Contacts" value="1000" />
    <add key="BulkBatchSize.Matters" value="1000" />
    <add key="BulkBatchSize.MatterNotes" value="1000" />
    <add key="BulkBatchSize.Tasks" value="1000" />
    <!-- How many companies are extracted at the same time (each uses its own token / rate limit). 1 = one at a time. -->
    <add key="MaxParallelCompanies" value="4" />
    <!-- Normal Visual Studio / Task Scheduler launch has no arguments. -->
    <add key="AbandonPreviousRunningRun" value="true" />
    <add key="PublishAfterValidation" value="true" />
    <!-- Incremental polling is deliberately opt-in. Run the incremental control script and test the incremental command before setting this to true. -->
    <add key="EnableIncrementalSync" value="true" />
    <!-- Poll these Clio endpoints with updated_since. The mode only updates Clio_Staging; it never publishes partial data. -->
    <add key="IncrementalEndpoints" value="Activities,CalendarEntries,Tasks,Matters,Bills,Folders,Contacts,LineItems,Allocations,PracticeAreas,Calendars,Relationships,TaskTypes,BankTransactions,CustomFields,CustomFieldSets,Users,ActivityDescriptions,MatterNotes" />
    <!-- The 5-minute incremental task only updates the raw tables. The reporting tables (PopulateTables and the post-sync procedures) are built by the manual full-check command. Set true only to rebuild after every poll. Timeout in minutes. -->
    <add key="IncrementalRebuildReporting" value="false" />
    <add key="ReportingBuildTimeoutMinutes" value="90" />
    <!-- Publish cycle step 4: build the reporting tables in Clio_Staging too? auto = only when the target's publisher procedure does NOT rebuild them itself (the deployed
         version calls PopulateTables, so a staging build would be the same 20+ minutes twice); true = always; false = never. -->
    <add key="StagingReportingBuild" value="auto" />
    <!-- During the long PopulateTables step of the reporting build, a progress line (views refreshed so far, the last one) is written every this many seconds (0 = off). -->
    <add key="ReportingBuildProgressSeconds" value="60" />
    <!-- Delete reconciliation safety limits: records missing in Clio above this share of a company's rows (per endpoint) are never touched, and at most this many records are confirmed one by one. -->
    <add key="DeleteReconcileMaxPercent" value="5" />
    <add key="DeleteReconcileMaxConfirmations" value="2000" />
    <!-- Small tables: up to this many missing records are always checked one by one, even when that is above the percent limit. Only an HTTP 404 ever counts as deleted. -->
    <add key="DeleteReconcileSmallTableAllowance" value="25" />
    <!-- Endpoints where Clio's complete ID listing is the source of truth (as in the old full sync), so a record missing from the listing is archived without the per-record check. -->
    <add key="DeleteReconcileListingAuthoritative" value="Users" />
    <!-- Maximum time for PublishApprovedClioStagingRun (copies the raw and reporting tables into the target database). -->
    <add key="PublishTimeoutMinutes" value="120" />
    <!-- Re-read a small overlap window so records changed during a prior poll are safely reprocessed. -->
    <add key="IncrementalOverlapMinutes" value="10" />
    <!-- A scheduled full check waits up to this many minutes for a running incremental sync to finish (0 = do not wait). -->
    <add key="FullCheckLockWaitMinutes" value="10" />
    <!-- The publish cycle needs the latest delete pass (control.DeleteRun, written by CSP.Clio.StagingDelete.exe) to be COMPLETE and not older than this many minutes (0 = do not check age). -->
    <add key="FullCheckMaxDeleteAgeMinutes" value="240" />
    <!-- Delete pass: how long an archive step would wait for a lock held by another run (minutes). The normal delete pass holds its lock for the whole run, so this is only used when the reconciler is called without it. -->
    <add key="DeleteLockWaitMinutes" value="30" />
    <!-- First load only (the no-argument full extraction): LastSyncTime is set this many minutes before the extraction started, like the production EXE does. -->
    <add key="FirstLoadLastSyncOffsetMinutes" value="5" />
    <!-- Delete pass: Clio limits the requests per ACCESS TOKEN (50 a minute at peak hours). The delete pass reads about 50 pages a minute, which would use up the
         budget of the stored token that the incremental passes need as well. With true the delete pass asks Clio for its own second access token (from the refresh
         token, not stored) and uses that. If Clio ends the older token when a new one is issued, this is detected and the pass shares the stored token again.
         Run "CSP.Clio.StagingSync.exe" with the argument token-test (two hyphens in front) to check how Clio behaves for your companies. -->
    <add key="DeleteUsesOwnClioToken" value="false" />
    <!-- Delete pass: while a long ID list is read, a progress line is written every this many seconds (0 = off), so "still reading" can be told from "stuck". -->
    <add key="DeleteProgressSeconds" value="60" />
    <!-- Delete pass: how many companies are listed at the same time (each has its own Clio token / rate limit). 1 = one at a time. -->
    <add key="DeleteMaxParallelCompanies" value="4" />
    <!-- Optional comma list to limit the delete endpoints (empty = all 19). A limited pass is recorded as PARTIAL and never counts as clean. -->
    <add key="DeleteReconcileEndpoints" value="" />
    <!-- Cycle mode (the one scheduled task, argument: cycle). Incremental window: passes every interval, for this long, then the incremental process ends and the publish can start. -->
    <add key="CycleIncrementalWindowMinutes" value="5" />
    <add key="CycleIncrementalIntervalMinutes" value="5" />
    <!-- A failed delete pass is started once more only when at least this many minutes of the incremental window are left. -->
    <add key="CycleDeleteRetryMinWindowMinutes" value="25" />
    <!-- Hang protection: a delete pass / a publish that runs longer than this is ended and the cycle goes on.
         The incremental process is ended when it runs longer than the window plus the slack (for the last pass). -->
    <add key="CycleDeleteWatchdogMinutes" value="90" />
    <add key="CyclePublishWatchdogMinutes" value="180" />
    <add key="CycleIncrementalWatchdogSlackMinutes" value="30" />
    <!-- Pause between two cycles. A cycle that ends within CycleShortCycleMinutes did nothing useful (for example a missing EXE or a database problem):
         the next one then waits CycleShortCycleWaitMinutes, so the log and the Clio API are not hammered. -->
    <add key="CycleGapMinutes" value="2" />
    <!-- LOGS. LogDirectory is the ONE folder for every log of both EXEs (empty = the folder Logs next to the EXE; a full path such as D:\Clio\Logs also works).
         Inside it: the cycle log of the day (the file to read), one folder per cycle (Cycles\yyyyMMdd-HHmmss) with the complete log of each part, and the folder Manual
         for parts started by hand. LogRetentionDays: cycle logs and cycle folders older than this are deleted (0 = never).
         CycleHeartbeatMinutes: a status line every N minutes while parts run (0 = off).
         CycleChildOutputInLog: how much of the parts' output goes into the cycle log: important (everything except routine lines), all, none. -->
    <add key="LogDirectory" value="" />
    <add key="LogRetentionDays" value="30" />
    <add key="CycleHeartbeatMinutes" value="5" />
    <add key="CycleChildOutputInLog" value="important" />
    <add key="CycleShortCycleMinutes" value="2" />
    <add key="CycleShortCycleWaitMinutes" value="5" />
    <!-- The delete EXE (must sit next to this EXE) and a switch to run the cycle without publishing. -->
    <add key="CycleDeleteExeName" value="CSP.Clio.StagingDelete.exe" />
    <add key="CyclePublishEnabled" value="true" />
    <!-- true = the cycle starts the delete EXE itself (in parallel with the incremental window). false = the delete EXE is its own scheduled job; the cycle then only runs
         incremental + publish, and the publish needs the latest COMPLETE delete pass to be younger than FullCheckMaxDeleteAgeMinutes (and none running). -->
    <add key="CycleRunsDelete" value="true" />
    <!-- First incremental poll for an endpoint starts this many hours before the first successful watermark. -->
    <add key="IncrementalInitialLookbackHours" value="72" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.1.1" newVersion="4.0.1.1" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Extensions.Primitives" publicKeyToken="adb9793829ddae60" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.1.4.0" newVersion="3.1.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Extensions.Configuration.Abstractions" publicKeyToken="adb9793829ddae60" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.1.4.0" newVersion="3.1.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Extensions.FileProviders.Abstractions" publicKeyToken="adb9793829ddae60" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.1.4.0" newVersion="3.1.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Extensions.FileSystemGlobbing" publicKeyToken="adb9793829ddae60" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.1.4.0" newVersion="3.1.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Extensions.Configuration" publicKeyToken="adb9793829ddae60" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.1.4.0" newVersion="3.1.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Extensions.FileProviders.Physical" publicKeyToken="adb9793829ddae60" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.1.4.0" newVersion="3.1.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Threading.Tasks.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.0.1" newVersion="4.2.0.1" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.ValueTuple" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.3.0" newVersion="4.0.3.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.3.0" newVersion="4.0.3.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Extensions.Configuration.FileExtensions" publicKeyToken="adb9793829ddae60" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.1.4.0" newVersion="3.1.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Text.Json" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Text.Encodings.Web" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Bcl.AsyncInterfaces" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <connectionStrings>
	  <add name="EKPBIEntities" connectionString="metadata=res://*/Data.ENModel.csdl|res://*/Data.ENModel.ssdl|res://*/Data.ENModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=(localdb)\MSSQLLocalDB;initial catalog=Clio_Staging;integrated security=True;multipleactiveresultsets=True;encrypt=False;trustservercertificate=True;application name=EntityFramework&quot;" providerName="System.Data.EntityClient" />
	  <!-- Production target for validation and publication. Change Initial Catalog here when moving between production and development. -->
	  <add name="ProductionSql" connectionString="data source=(localdb)\MSSQLLocalDB;initial catalog=EKPBI_New_Dev;integrated security=True;multipleactiveresultsets=True;encrypt=False;trustservercertificate=True;application name=CSP.Clio.StagingSync" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.SqlConnectionFactory, EntityFramework" />
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
  <applicationSettings>
    <CSP.Clio.Sync.Properties.Settings>
      <setting name="DataSavePartitionSize" serializeAs="String">
        <value>50</value>
      </setting>
    </CSP.Clio.Sync.Properties.Settings>
  </applicationSettings>
</configuration>
